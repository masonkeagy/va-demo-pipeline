{
  "compilerOptions": {
    "target": "ES2019",
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": ["ES2019", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "typeRoots": [
      "./generated",
      "./node_modules/@types"
    ]
  },
  "include": [
    "**/*.ts",
    "generated/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "out",
    "dist"
  ]
}